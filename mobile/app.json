{
  "expo": {
    "name": "LikTok",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DB2766",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "LikTok",
      "shortName": "LikTok",
      "themeColor": "#DB2766"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép LikTok dùng camera để quay video và story.",
          "microphonePermission": "Cho phép LikTok dùng micro để thu âm khi quay video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép LikTok chọn ảnh và video trong thư viện để đăng."
        }
      ],
      "expo-audio"
    ]
  }
}
