@startuml seq_live
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam maxMessageSize 260
skinparam BoxPadding 8
skinparam ArrowColor #333333
skinparam sequence {
  LifeLineBorderColor #8A8A8A
  ParticipantBackgroundColor #EEF1F8
  ParticipantBorderColor #6B7A90
  ActorBackgroundColor #EEF1F8
  ActorBorderColor #6B7A90
  BoxBorderColor #9DB4CF
  DividerBackgroundColor #FFFFFF
  GroupBorderColor #333333
}
skinparam BoundaryBackgroundColor #EEF1F8
skinparam BoundaryBorderColor #6B7A90
skinparam ControlBackgroundColor #EEF1F8
skinparam ControlBorderColor #6B7A90
skinparam EntityBackgroundColor #EEF1F8
skinparam EntityBorderColor #6B7A90
skinparam DatabaseBackgroundColor #EEF1F8
skinparam DatabaseBorderColor #6B7A90
skinparam QueueBackgroundColor #EEF1F8
skinparam QueueBorderColor #6B7A90
skinparam CollectionsBackgroundColor #EEF1F8
skinparam CollectionsBorderColor #6B7A90
hide footbox
title Sơ đồ tuần tự - UC14 Xem livestream (WebSocket STOMP)

actor "Người xem" as U
box "Client (Ứng dụng di động)" #E8F2FC
  boundary "LiveWatchScreen" as LW
  control "api/lives.ts\nconnectLive()\n(STOMP Client)" as CL
end box
box "Server (Backend Spring Boot)" #FFF5E6
  control "WebSocketConfig\n(ChannelInterceptor)" as WSC
  control "LiveWebSocketController" as CTRL
  control "LiveStreamService" as SVC
  queue "Simple broker\n/topic/live/{id}" as BR
  control "LiveDisconnectListener" as DL
end box
database "MySQL" as DB

== 1. Người xem mở phòng live ==
U -> LW : 1: Mở phòng live
LW -> LW : 1.1: liveApi.getById(id), liveApi.messages(id)\n(REST GET /api/lives/{id}, /messages)
LW -> CL : 1.2: connectLive(liveId, getAuthToken(), onEvent)
CL -> WSC : 1.2.1: CONNECT ws(s)://<host>/ws\nheader Authorization: Bearer <JWT>
WSC -> WSC : 1.2.2: jwtService.getUserId(token),\nkiểm tra user tồn tại, chưa bị khoá\n→ accessor.setUser(principal)
WSC --> CL : 1.2.3: CONNECTED
CL -> BR : 1.2.4: SUBSCRIBE /topic/live/{id}
CL -> BR : 1.2.5: SUBSCRIBE /user/queue/errors

== Kết nối xong: vào phòng ==
CL -> CTRL : 1.2.6: SEND /app/live/{id}/join
CTRL -> SVC : 1.2.7: join(id, userId)
SVC -> DB : 1.2.8: findActiveLive(id)\n(status phải là LIVE)
DB --> SVC : 1.2.9: LiveStream (không LIVE → lỗi)
SVC -> SVC : 1.2.10: viewers[id].add(userId)\n(ConcurrentHashMap trong bộ nhớ)
SVC -> BR : 1.2.11: convertAndSend /topic/live/{id}\n{event: "VIEWERS", viewerCount}
BR --> CL : 1.2.12: MESSAGE VIEWERS
CL --> LW : 1.3: onEvent → cập nhật số người xem

== 2. Người xem gửi bình luận ==
U -> LW : 2: Gõ tin nhắn, bấm Gửi
LW -> CL : 2.1: conn.chat(content)
CL -> CTRL : 2.1.1: SEND /app/live/{id}/chat {content}
CTRL -> SVC : 2.1.2: sendMessage(id, userId, COMMENT, content)
SVC -> DB : 2.1.3: INSERT INTO live_messages
DB --> SVC : 2.1.4: LiveMessage (đã có id)
SVC -> BR : 2.1.5: {event: "COMMENT", message}
BR --> CL : 2.1.6: MESSAGE COMMENT (tới mọi người trong phòng)
CL --> LW : 2.2: thêm tin nhắn vào khung chat

== 3. Người xem thả tim ==
U -> LW : 3: Bấm tim
LW -> CL : 3.1: conn.react('heart')
CL -> CTRL : 3.1.1: SEND /app/live/{id}/react {content: "heart"}
CTRL -> SVC : 3.1.2: sendMessage(id, userId, REACTION, "heart")
note right of SVC : chỉ nhận heart | like | smile
SVC -> DB : 3.1.3: INSERT INTO live_messages
DB --> SVC : 3.1.4: LiveMessage (đã có id)
SVC -> BR : 3.1.5: {event: "REACTION", message}
BR --> CL : 3.1.6: MESSAGE REACTION
CL --> LW : 3.2: hiệu ứng tim bay

alt Lỗi xử lý (live đã kết thúc, nội dung rỗng/quá dài, chưa đăng nhập)
  CTRL -> CL : 3.2.1: @SendToUser /user/queue/errors\n{status, message}
  CL --> LW : 3.3: onError → hiện thông báo
end

== 4. Rời phòng (bấm thoát hoặc mất kết nối) ==
alt Bấm thoát (conn.close())
  CL -> CTRL : 4.1.1: SEND /app/live/{id}/leave
  CTRL -> SVC : 4.1.2: leave(id, userId)
  SVC -> BR : 4.1.3: {event: "VIEWERS", viewerCount}
  CL -> CL : 4.1.4: client.deactivate()
else Mất kết nối / tắt app
  WSC -> DL : 4.1.1: Spring phát SessionDisconnectEvent
  DL -> SVC : 4.1.2: leaveAll(userId)
  SVC -> BR : 4.1.3: {event: "VIEWERS", viewerCount}
  DL -> SVC : 4.1.4: endAllLiveOfHost(userId)
  note right of SVC
    Nếu người ngắt là chủ phòng: chốt viewerCount,
    status = ENDED, gửi {event: "ENDED"} cho người xem
  end note
end
@enduml
