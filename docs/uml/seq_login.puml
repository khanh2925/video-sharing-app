@startuml seq_login
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam maxMessageSize 260
skinparam BoxPadding 8
skinparam ArrowColor #333333
skinparam sequence {
  LifeLineBorderColor #8A8A8A
  ParticipantBackgroundColor #EEF1F8
  ParticipantBorderColor #6B7A90
  ActorBackgroundColor #EEF1F8
  ActorBorderColor #6B7A90
  BoxBorderColor #9DB4CF
  DividerBackgroundColor #FFFFFF
  GroupBorderColor #333333
}
skinparam BoundaryBackgroundColor #EEF1F8
skinparam BoundaryBorderColor #6B7A90
skinparam ControlBackgroundColor #EEF1F8
skinparam ControlBorderColor #6B7A90
skinparam EntityBackgroundColor #EEF1F8
skinparam EntityBorderColor #6B7A90
skinparam DatabaseBackgroundColor #EEF1F8
skinparam DatabaseBorderColor #6B7A90
skinparam QueueBackgroundColor #EEF1F8
skinparam QueueBorderColor #6B7A90
skinparam CollectionsBackgroundColor #EEF1F8
skinparam CollectionsBorderColor #6B7A90
hide footbox
title Sơ đồ tuần tự - UC02 Đăng nhập

actor "Người dùng" as U
box "Client (Ứng dụng di động)" #E8F2FC
  boundary "LoginScreen" as LS
  control "AuthContext" as AC
  control "api/auth.ts\n(authApi)" as API
end box
box "Server (Backend Spring Boot)" #FFF5E6
  control "AuthController" as CTRL
  control "AuthService" as SVC
  entity "UserRepository" as REPO
  control "PasswordEncoder\n(BCrypt)" as PE
  control "JwtService" as JWT
end box
database "MySQL" as DB

== 1. Người dùng nhập tài khoản, bấm Đăng nhập ==
U -> LS : 1: Nhập tên đăng nhập/email,\nmật khẩu, bấm "Đăng nhập"
LS -> LS : 1.1: validate()\n(bỏ trống thì báo lỗi dưới ô)
LS -> AC : 1.2: login({usernameOrEmail, password})
AC -> API : 1.2.1: authApi.login(body)
API -> CTRL : 1.2.2: POST /api/auth/login\n{usernameOrEmail, password}
CTRL -> SVC : 1.2.3: login(request)
SVC -> SVC : 1.2.4: normalize(): trim + chữ thường
alt có ký tự "@"
  SVC -> REPO : 1.2.5: findByEmail(identifier)
else không có "@"
  SVC -> REPO : 1.2.5: findByUsername(identifier)
end
REPO -> DB : 1.2.6: SELECT * FROM users WHERE ...
DB --> REPO : 1.2.7: bản ghi / rỗng
REPO --> SVC : 1.2.8: Optional<User>
SVC -> PE : 1.2.9: matches(password, passwordHash)
PE --> SVC : 1.2.10: true / false

alt Không có tài khoản hoặc sai mật khẩu
  SVC --> CTRL : 1.2.11: ApiException 401
  CTRL --> API : 1.2.12: 401 {status, message:\n"Tên đăng nhập hoặc mật khẩu không đúng", timestamp}
  API --> AC : 1.2.13: ném lỗi Axios
  AC --> LS : 1.3: ném lỗi
  LS -> LS : 1.4: setServerError(getErrorMessage(e))
  LS --> U : 1.5: Hiện câu lỗi
else Tài khoản bị khoá (user.locked = true)
  SVC --> CTRL : 1.2.11: ApiException 403
  CTRL --> API : 1.2.12: 403 {message: "Tài khoản đã bị khóa"}
  API --> AC : 1.2.13: ném lỗi Axios
  AC --> LS : 1.3: ném lỗi
  LS --> U : 1.4: Hiện "Tài khoản đã bị khóa"
else Hợp lệ
  SVC -> JWT : 1.2.11: generateToken(user)
  JWT --> SVC : 1.2.12: JWT (sub = id, role, hạn 7 ngày)
  SVC --> CTRL : 1.2.13: AuthResponse(token, user)
  CTRL --> API : 1.2.14: 200 {token, user}
  API --> AC : 1.2.15: AuthResponse
  AC -> AC : 1.2.16: saveSession():\nSecureStore.setItemAsync("vsa_token", token)\nsetAuthToken(token); setUser(user)
  AC --> LS : 1.3: hoàn tất
  note over AC, LS
    user khác null → RootNavigator
    tự chuyển sang MainTabs (Trang chủ)
  end note
end
@enduml
