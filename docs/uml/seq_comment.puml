@startuml seq_comment
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam maxMessageSize 260
skinparam BoxPadding 8
skinparam ArrowColor #333333
skinparam sequence {
  LifeLineBorderColor #8A8A8A
  ParticipantBackgroundColor #EEF1F8
  ParticipantBorderColor #6B7A90
  ActorBackgroundColor #EEF1F8
  ActorBorderColor #6B7A90
  BoxBorderColor #9DB4CF
  DividerBackgroundColor #FFFFFF
  GroupBorderColor #333333
}
skinparam BoundaryBackgroundColor #EEF1F8
skinparam BoundaryBorderColor #6B7A90
skinparam ControlBackgroundColor #EEF1F8
skinparam ControlBorderColor #6B7A90
skinparam EntityBackgroundColor #EEF1F8
skinparam EntityBorderColor #6B7A90
skinparam DatabaseBackgroundColor #EEF1F8
skinparam DatabaseBorderColor #6B7A90
skinparam QueueBackgroundColor #EEF1F8
skinparam QueueBorderColor #6B7A90
skinparam CollectionsBackgroundColor #EEF1F8
skinparam CollectionsBorderColor #6B7A90
hide footbox
title Sơ đồ tuần tự - UC11 Bình luận video

actor "Người dùng" as U
box "Client (Ứng dụng di động)" #E8F2FC
  boundary "WatchScreen" as W
  boundary "CommentsScreen" as CS
  control "api/videos.ts\n(videoApi)" as API
end box
box "Server (Backend Spring Boot)" #FFF5E6
  control "InteractionController" as CTRL
  control "InteractionService" as SVC
  control "VideoAccessPolicy" as POL
  entity "CommentRepository /\nVideoRepository" as REPO
end box
database "MySQL" as DB

== 1. Người dùng mở danh sách bình luận ==
U -> W : 1: Bấm biểu tượng bình luận
W -> CS : 1.1: navigate('Comments',\n{videoId, allowComments})
CS -> API : 1.2: videoApi.comments(videoId, page)
API -> CTRL : 1.2.1: GET /api/videos/{id}/comments?page=0
CTRL -> SVC : 1.2.2: getComments(videoId, page)
SVC -> REPO : 1.2.3: findByVideoIdOrderByCreatedAtDesc\n(videoId, page 20)
REPO -> DB : 1.2.4: SELECT ... FROM comments
DB --> REPO : 1.2.5: các bản ghi
REPO --> SVC : 1.2.6: Page<Comment>
SVC --> CTRL : 1.2.7: PageResponse<CommentResponse>
CTRL --> API : 1.2.8: 200 PageResponse<CommentResponse>
API --> CS : 1.3: danh sách bình luận
note right of CS
  allowComments = false → ẩn ô viết,
  hiện "Tác giả đã tắt bình luận"
end note

== 2. Người dùng gửi bình luận ==
U -> CS : 2: Nhập nội dung, bấm Gửi
CS -> API : 2.1: videoApi.addComment(videoId, content)
API -> CTRL : 2.1.1: POST /api/videos/{videoId}/comments\n{content} + Authorization: Bearer
CTRL -> SVC : 2.1.2: createComment(videoId, request)
SVC -> POL : 2.1.3: findViewableVideo(videoId, userId)
POL --> SVC : 2.1.4: Video (không xem được → 404)
SVC -> SVC : 2.1.5: checkPublished(video)

alt Video đã tắt bình luận (allowComments = false)
  SVC --> CTRL : 2.1.6: ApiException 409
  CTRL --> API : 2.1.7: 409 {message: "Video đã tắt bình luận"}
  API --> CS : 2.2: lỗi
  CS --> U : 2.3: Alert "Không gửi được"
else Cho phép bình luận
  SVC -> REPO : 2.1.6: commentRepository.save(Comment)
  REPO -> DB : 2.1.7: INSERT INTO comments
  DB --> REPO : 2.1.8: OK
  REPO --> SVC : 2.1.9: Comment (đã có id)
  SVC -> REPO : 2.1.10: videoRepository.addCommentCount(videoId, 1)
  REPO -> DB : 2.1.11: UPDATE videos SET comment_count = comment_count + 1
  DB --> REPO : 2.1.12: 1 dòng
  REPO --> SVC : 2.1.13: OK
  SVC -> SVC : 2.1.14: toResponse(comment, userId)
  SVC --> CTRL : 2.1.15: CommentResponse
  CTRL --> API : 2.1.16: 201 Created + CommentResponse
  API --> CS : 2.2: Comment
  CS --> U : 2.3: Thêm bình luận lên đầu danh sách
end

note over U, CS
  Khách bấm Gửi → requireAuth() chuyển sang
  Đăng nhập (R3); backend cũng trả 401 nếu thiếu token.
end note
@enduml
