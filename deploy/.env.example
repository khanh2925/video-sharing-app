# setup-vps.sh tự tạo deploy/.env với giá trị ngẫu nhiên. File này chỉ để tham khảo.
# KHÔNG commit deploy/.env lên Git.

# Tên miền trỏ về IP VPS. Không có tên miền thì dùng sslip.io miễn phí: <ip-nối-bằng-gạch>.sslip.io
DOMAIN=140-238-1-2.sslip.io

MYSQL_ROOT_PASSWORD=doi-mat-khau-nay
MYSQL_PASSWORD=doi-mat-khau-nay
# Ít nhất 32 ký tự
JWT_SECRET=doi-chuoi-bi-mat-nay-it-nhat-32-ky-tu

# Spring AI (gợi ý video, chatbot). Để trống hoặc xoá dòng = tắt AI. Bật: SPRING_PROFILES_ACTIVE=ai
# Bật xong, đăng nhập admin gọi POST /api/admin/ai/reindex một lần để nạp vector cho video có sẵn.
SPRING_PROFILES_ACTIVE=
# Key Gemini: GEMINI_API_KEY dùng tạo vector; GEMINI_CHAT_API_KEY (tuỳ chọn) dùng riêng cho chatbot
GEMINI_API_KEY=
GEMINI_CHAT_API_KEY=
# Bên trả lời chatbot: google-genai (mặc định) hoặc openai
AI_CHAT_PROVIDER=google-genai
# Mật khẩu kho vector (chỉ dùng trong mạng Docker, không mở ra ngoài)
VECTOR_DB_PASSWORD=doi-mat-khau-nay

# Trang web xem database https://<DOMAIN>/db/ (Adminer). Không đặt = trang tắt và bị khoá.
# Đừng sửa tay: chạy bash deploy/set-db-panel-password.sh để tự ghi 3 dòng dưới đây.
# DB_PANEL_USER=admin
# DB_PANEL_HASH='<mã băm do script tạo>'
# COMPOSE_PROFILES=dbpanel
