@startuml usecase
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF0F5
  BorderColor #E8457C
}
skinparam nodesep 12
skinparam ranksep 60
title Biểu đồ Use Case – Video Sharing App

actor "Khách" as Guest
actor "Người dùng" as User
actor "Người phát live" as Streamer

rectangle "Video Sharing App" {
  usecase "UC01 Đăng ký" as UC01
  usecase "UC03 Xem trang chủ" as UC03
  usecase "UC04 Duyệt video theo chủ đề" as UC04
  usecase "UC05 Tìm kiếm" as UC05
  usecase "UC06 Xem video" as UC06
  usecase "UC11 Xem hồ sơ người khác" as UC11

  usecase "UC07 Thích video" as UC07
  usecase "UC08 Bình luận video" as UC08
  usecase "UC09 Theo dõi người dùng" as UC09
  usecase "UC10 Xem followers / following" as UC10
  usecase "UC12 Quản lý hồ sơ cá nhân" as UC12
  usecase "UC13 Tạo và đăng video" as UC13
  usecase "UC18 Xem live, chat, thả cảm xúc" as UC18
  usecase "UC17 Phát livestream" as UC17
  usecase "UC19 Kiểm duyệt nội dung" as UC19

  usecase "UC02 Đăng nhập / Đăng xuất" as UC02
  usecase "UC14 Chọn bộ lọc" as UC14
  usecase "UC15 Chọn nhạc nền" as UC15
  usecase "UC16 Lưu nháp" as UC16
}

actor "Quản trị viên" as Admin

Guest <|-- User
User <|-- Streamer

Guest --> UC01
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC06
Guest --> UC11
Guest --> UC02

User --> UC07
User --> UC08
User --> UC09
User --> UC10
User --> UC12
User --> UC13
User --> UC18
Streamer --> UC17
UC19 <-- Admin

UC07 ..> UC02 : <<include>>
UC08 ..> UC02 : <<include>>
UC09 ..> UC02 : <<include>>
UC12 ..> UC02 : <<include>>
UC13 ..> UC02 : <<include>>
UC17 ..> UC02 : <<include>>
UC18 ..> UC02 : <<include>>
UC19 ..> UC02 : <<include>>
UC04 ..> UC03 : <<extend>>
UC14 ..> UC13 : <<extend>>
UC15 ..> UC13 : <<extend>>
UC16 ..> UC13 : <<extend>>
@enduml
